---
import siteData from '../data/site.json';

// Extraction et sécurisation des données avec valeurs de repli (fallbacks)
const companyName = siteData.nom || siteData.client || "Mon Entreprise";
const metaTitle = siteData.site?.title || `${companyName} | Artisan & Services Locaux`;
const metaDescription = siteData.site?.description || siteData.description || `Découvrez les services professionnels de ${companyName}. Devis rapide et intervention locale garantie.`;
const siteUrl = siteData.site?.url || "https://example.fr";

// Paramètres de charte graphique dynamique
const palette = siteData.theme?.palette || {
  primary: "#2563EB",
  secondary: "#F3F4F6",
  accent: "#1D4ED8",
  background: "#FFFFFF",
  text: "#1F2937",
  cardBg: "#F9FAFB"
};

const typography = siteData.theme?.typography || {
  heading: "system-ui, -apple-system, sans-serif",
  body: "system-ui, -apple-system, sans-serif"
};

const uiRadius = siteData.theme?.borderRadius || "0.5rem";

// Informations de contact et géolocalisation
const contact = siteData.contact || {};
const address = contact.address || "1 rue de la République";
const city = contact.city || "Paris";
const postalCode = contact.postalCode || "75001";
const phone = contact.phone || "01 02 03 04 05";
const email = contact.email || "contact@monentreprise.fr";
const siret = siteData.legal?.siret || "123 456 789 00012";

// Contenus métiers
const services = siteData.services || [
  { title: "Prestation Sur-Mesure", description: "Une réponse ciblée et adaptée aux spécificités de votre demande." },
  { title: "Intervention Rapide", description: "Disponibilité et réactivité pour vous garantir un service continu." },
  { title: "Accompagnement Dédié", description: "Conseils d'experts tout au long de la réalisation de votre projet." }
];

const faq = siteData.faq || [
  { 
    question: `Où intervient principalement ${companyName} ?`, 
    answer: `Nous intervenons principalement sur le secteur de ${city} et ses communes limitrophes.` 
  },
  { 
    question: "Comment demander un devis gratuit ?", 
    answer: "Vous pouvez nous joindre par téléphone ou remplir le formulaire ci-dessous pour une réponse sous 24h." 
  }
];

// Données structurées Schema.org pour Google, Perplexity et ChatGPT
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": `${siteUrl}/#business`,
      "name": companyName,
      "url": siteUrl,
      "telephone": phone,
      "email": email,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": address,
        "addressLocality": city,
        "postalCode": postalCode,
        "addressCountry": "FR"
      },
      "description": metaDescription
    },
    {
      "@type": "FAQPage",
      "@id": `${siteUrl}/#faq`,
      "mainEntity": faq.map(item => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.answer
        }
      }))
    }
  ]
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph / Réseaux Sociaux -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Données structurées SEO Local et FAQ -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Application dynamique du thème généré par l'IA -->
    <style define:vars={{
      colorPrimary: palette.primary,
      colorSecondary: palette.secondary,
      colorAccent: palette.accent,
      colorBg: palette.background,
      colorText: palette.text,
      colorCard: palette.cardBg,
      fontHeading: typography.heading,
      fontBody: typography.body,
      radius: uiRadius
    }}>
      :root {
        --primary: var(--colorPrimary);
        --secondary: var(--colorSecondary);
        --accent: var(--colorAccent);
        --bg: var(--colorBg);
        --text: var(--colorText);
        --card-bg: var(--colorCard);
        --font-h: var(--fontHeading);
        --font-b: var(--fontBody);
        --rad: var(--radius);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: var(--bg);
        color: var(--text);
        font-family: var(--font-b);
        line-height: 1.6;
      }

      h1, h2, h3 {
        font-family: var(--font-h);
        line-height: 1.25;
        color: var(--text);
      }

      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .btn {
        display: inline-block;
        padding: 0.85rem 1.75rem;
        border-radius: var(--rad);
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        border: none;
        transition: opacity 0.2s ease;
      }
      .btn:hover { opacity: 0.9; }
      .btn-primary { background-color: var(--primary); color: #ffffff; }
      .btn-secondary { background-color: var(--secondary); color: var(--text); }

      /* En-tête */
      header {
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        padding: 1rem 0;
      }
      .nav-wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .logo {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--primary);
        text-decoration: none;
      }

      /* Hero */
      .hero {
        padding: 5rem 0 4rem 0;
        text-align: center;
      }
      .hero h1 {
        font-size: 2.75rem;
        margin-bottom: 1.25rem;
      }
      .hero p {
        font-size: 1.25rem;
        max-width: 700px;
        margin: 0 auto 2rem auto;
        opacity: 0.9;
      }
      .hero-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
      }

      /* Grille de services */
      .services-section {
        padding: 4rem 0;
      }
      .section-title {
        text-align: center;
        margin-bottom: 3rem;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
      }
      .card {
        background-color: var(--card-bg);
        padding: 2rem;
        border-radius: var(--rad);
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
      }
      .card h3 {
        margin-bottom: 0.75rem;
        color: var(--primary);
      }

      /* FAQ */
      .faq-section {
        padding: 4rem 0;
        background-color: var(--secondary);
      }
      .faq-item {
        background: var(--bg);
        padding: 1.5rem;
        border-radius: var(--rad);
        margin-bottom: 1rem;
      }
      .faq-item h3 {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
      }

      /* Contact */
      .contact-section {
        padding: 4rem 0;
      }
      .contact-layout {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 3rem;
      }
      .form-group {
        margin-bottom: 1.25rem;
      }
      .form-group label {
        display: block;
        margin-bottom: 0.35rem;
        font-size: 0.9rem;
        font-weight: 600;
      }
      .form-group input, .form-group textarea {
        width: 100%;
        padding: 0.75rem;
        border-radius: var(--rad);
        border: 1px solid rgba(0,0,0,0.2);
        font-family: inherit;
      }
      .rgpd-consent {
        font-size: 0.8rem;
        margin-bottom: 1rem;
        opacity: 0.8;
      }

      /* Pied de page */
      footer {
        background: #111827;
        color: #9CA3AF;
        padding: 3rem 0;
        margin-top: 4rem;
        font-size: 0.9rem;
      }
      .footer-links {
        display: flex;
        gap: 1.5rem;
        margin-top: 1rem;
      }
      .footer-links a {
        color: #FFFFFF;
        text-decoration: underline;
      }

      /* Bandeau Cookie RGPD */
      #cookie-banner {
        position: fixed;
        bottom: 1.5rem;
        left: 1.5rem;
        right: 1.5rem;
        max-width: 500px;
        background: #FFFFFF;
        color: #1F2937;
        padding: 1.5rem;
        border-radius: var(--rad);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        display: none;
        z-index: 9999;
        border: 1px solid rgba(0,0,0,0.08);
      }
      .cookie-buttons {
        display: flex;
        gap: 0.75rem;
        margin-top: 1rem;
      }
    </style>
  </head>

  <body>
    <!-- En-tête -->
    <header>
      <div class="container nav-wrap">
        <a href="/" class="logo">{companyName}</a>
        <a href={`tel:${phone}`} class="btn btn-primary">Appeler : {phone}</a>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="hero container">
      <h1>{metaTitle}</h1>
      <p>{metaDescription}</p>
      <div class="hero-actions">
        <a href="#contact" class="btn btn-primary">Demander un devis gratuit</a>
        <a href="#services" class="btn btn-secondary">Découvrir nos services</a>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="services-section">
      <div class="container">
        <div class="section-title">
          <h2>Nos Services & Savoir-faire</h2>
          <p>Des prestations adaptées à vos attentes locales</p>
        </div>
        <div class="grid">
          {services.map((item) => (
            <article class="card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ optimisée LLM & SEO -->
    <section class="faq-section">
      <div class="container">
        <div class="section-title">
          <h2>Foire Aux Questions</h2>
          <p>Toutes les réponses à vos interrogations</p>
        </div>
        <div class="faq-list">
          {faq.map((item) => (
            <div class="faq-item">
              <h3>{item.question}</h3>
              <p>{item.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Formulaire de contact sécurisé & RGPD -->
    <section id="contact" class="contact-section container">
      <div class="contact-layout">
        <div>
          <h2>Contactez-nous</h2>
          <p style="margin-bottom: 1.5rem;">Prenez rendez-vous directement ou exposez-nous votre besoin.</p>
          <p><strong>Adresse :</strong> {address}, {postalCode} {city}</p>
          <p><strong>Téléphone :</strong> {phone}</p>
          <p><strong>Email :</strong> {email}</p>
        </div>

        <form method="POST" action="/merci" onsubmit="event.preventDefault(); alert('Message envoyé.');">
          <div class="form-group">
            <label for="name">Nom complet</label>
            <input type="text" id="name" name="name" required placeholder="Votre nom" />
          </div>
          <div class="form-group">
            <label for="contact-field">Téléphone ou Email</label>
            <input type="text" id="contact-field" name="contact" required placeholder="06... ou email@exemple.fr" />
          </div>
          <div class="form-group">
            <label for="message">Votre message</label>
            <textarea id="message" name="message" rows="4" required placeholder="Précisez votre demande..."></textarea>
          </div>
          <p class="rgpd-consent">
            En validant ce formulaire, vous consentez à ce que {companyName} conserve vos coordonnées afin de traiter votre demande de contact, conformément à notre <a href="/politique-confidentialite" style="color: var(--primary);">politique de confidentialité</a>.
          </p>
          <button type="submit" class="btn btn-primary" style="width: 100%;">Envoyer la demande</button>
        </form>
      </div>
    </section>

    <!-- Pied de page -->
    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} {companyName} - SIRET : {siret}</p>
        <p>{address}, {postalCode} {city}</p>
        <div class="footer-links">
          <a href="/mentions-legales">Mentions Légales</a>
          <a href="/politique-confidentialite">Politique de Confidentialité</a>
        </div>
      </div>
    </footer>

    <!-- Bandeau Cookie RGPD (Sans traceur tiers actif par défaut) -->
    <aside id="cookie-banner" role="dialog" aria-labelledby="cookie-title">
      <h4 id="cookie-title" style="margin-bottom: 0.5rem;">Gestion des cookies</h4>
      <p style="font-size: 0.85rem;">Ce site utilise des cookies techniques nécessaires à son bon fonctionnement. Aucun traceur publicitaire n'est déposé sans consentement.</p>
      <div class="cookie-buttons">
        <button id="cookie-accept" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Accepter</button>
        <button id="cookie-refuse" class="btn btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.85rem;">Refuser</button>
      </div>
    </aside>

    <script is:inline>
      const banner = document.getElementById('cookie-banner');
      const acceptBtn = document.getElementById('cookie-accept');
      const refuseBtn = document.getElementById('cookie-refuse');

      if (!localStorage.getItem('cookieConsent')) {
        banner.style.display = 'block';
      }

      acceptBtn?.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'accepted');
        banner.style.display = 'none';
      });

      refuseBtn?.addEventListener('click', () => {
        localStorage.setItem('cookieConsent', 'refused');
        banner.style.display = 'none';
      });
    </script>
  </body>
</html>
