---
// Chemin : src/pages/index.astro
import site from '../data/site.json';

const gaId = site.analytics?.googleAnalyticsId || '';

const schemaLocalBusiness = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Plumber",
      "@id": "https://vitrine-template.pages.dev/#business",
      "name": site.identite.nomCommercial,
      "description": site.identite.description,
      "telephone": site.contact.telephoneLien,
      "email": site.contact.email,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": site.contact.adresse,
        "addressLocality": site.contact.ville,
        "postalCode": site.contact.codePostal,
        "addressCountry": "FR"
      },
      "areaServed": site.contact.zoneIntervention,
      "priceRange": "€€"
    },
    {
      "@type": "FAQPage",
      "@id": "https://vitrine-template.pages.dev/#faq",
      "mainEntity": site.faq.map((item) => ({
        "@type": "Question",
        "name": item.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.reponse
        }
      }))
    }
  ]
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{site.identite.nomCommercial} — {site.identite.metier} à {site.contact.ville}</title>
    <meta name="description" content={site.identite.description} />
    <meta name="robots" content="index, follow" />

    <!-- SEO Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaLocalBusiness)} />

    <style>
      :root {
        --primary: #0f172a;
        --accent: #ea580c;
        --accent-hover: #c2410c;
        --bg-page: #f8fafc;
        --bg-card: #ffffff;
        --text: #334155;
        --text-dark: #0f172a;
        --border: #e2e8f0;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: system-ui, -apple-system, sans-serif;
        background-color: var(--bg-page);
        color: var(--text);
        line-height: 1.6;
      }

      header {
        background: var(--bg-card);
        border-bottom: 1px solid var(--border);
        padding: 1rem 1.5rem;
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .header-content {
        max-width: 1000px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo-titre {
        font-weight: 700;
        color: var(--text-dark);
        font-size: 1.15rem;
      }

      .cta-phone-nav {
        background: var(--accent);
        color: #ffffff;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.9rem;
      }

      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }

      .hero {
        background: var(--bg-card);
        padding: 3rem 2rem;
        border-radius: 12px;
        border: 1px solid var(--border);
        text-align: center;
        margin-bottom: 2rem;
      }

      .badge {
        display: inline-block;
        background: #f1f5f9;
        color: #475569;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.3rem 0.8rem;
        border-radius: 9999px;
        margin-bottom: 1rem;
      }

      h1 {
        font-size: 2.2rem;
        color: var(--text-dark);
        line-height: 1.2;
        margin-bottom: 1rem;
      }

      .tagline {
        font-size: 1.2rem;
        color: #64748b;
        max-width: 700px;
        margin: 0 auto 1.5rem;
      }

      .btn-urgence {
        display: inline-block;
        background: var(--accent);
        color: #ffffff;
        padding: 0.9rem 2rem;
        border-radius: 8px;
        text-decoration: none;
        font-size: 1.1rem;
        font-weight: 700;
        box-shadow: 0 4px 6px -1px rgba(234, 88, 12, 0.25);
        transition: background 0.2s;
      }

      .btn-urgence:hover {
        background: var(--accent-hover);
      }

      .engagements {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2.5rem;
      }

      .engagement-item {
        background: var(--bg-card);
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid var(--border);
        text-align: center;
        font-weight: 600;
        color: var(--text-dark);
      }

      h2 {
        font-size: 1.6rem;
        color: var(--text-dark);
        margin: 2rem 0 1rem;
      }

      .grid-services {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .card-service {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .card-service h3 {
        color: var(--text-dark);
        margin-bottom: 0.5rem;
      }

      .card-service p {
        font-size: 0.95rem;
        color: #64748b;
        margin-bottom: 1rem;
      }

      .tarif-service {
        font-weight: 700;
        color: var(--text-dark);
        font-size: 1rem;
        border-top: 1px solid var(--border);
        padding-top: 0.75rem;
      }

      .zone-box {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 8px;
        padding: 1.5rem;
        margin: 2.5rem 0;
      }

      .zone-box strong {
        color: #1e40af;
      }

      .faq-list {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 1.5rem;
      }

      details {
        border-bottom: 1px solid var(--border);
        padding: 1rem 0;
      }

      details:last-child {
        border-bottom: none;
      }

      summary {
        font-weight: 600;
        color: var(--text-dark);
        cursor: pointer;
      }

      details p {
        margin-top: 0.5rem;
        font-size: 0.95rem;
        color: #64748b;
      }

      /* Footer */
      footer {
        background: #0f172a;
        color: #94a3b8;
        font-size: 0.85rem;
        padding: 3rem 1rem 2rem;
        margin-top: 3rem;
      }

      .footer-content {
        max-width: 1000px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 2rem;
      }

      footer h4 {
        color: #ffffff;
        margin-bottom: 0.8rem;
      }

      footer a {
        color: #cbd5e1;
        text-decoration: underline;
      }

      .mentions-legales {
        max-width: 1000px;
        margin: 2rem auto 0;
        padding-top: 1.5rem;
        border-top: 1px solid #334155;
        font-size: 0.75rem;
        line-height: 1.5;
      }

      .btn-gestion-cookies {
        background: transparent;
        border: none;
        color: #94a3b8;
        text-decoration: underline;
        font-size: 0.75rem;
        cursor: pointer;
        padding: 0;
        margin-top: 0.5rem;
      }

      .btn-gestion-cookies:hover {
        color: #ffffff;
      }

      /* Bandeau Cookies RGPD */
      #cookie-banner {
        position: fixed;
        bottom: 1.5rem;
        left: 1.5rem;
        right: 1.5rem;
        max-width: 520px;
        margin: 0 auto;
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
        padding: 1.5rem;
        z-index: 9999;
        display: none;
      }

      #cookie-banner.visible {
        display: block;
      }

      .cookie-title {
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
      }

      .cookie-text {
        font-size: 0.85rem;
        color: #64748b;
        margin-bottom: 1rem;
        line-height: 1.4;
      }

      .cookie-actions {
        display: flex;
        gap: 0.75rem;
      }

      .btn-cookie {
        flex: 1;
        padding: 0.6rem 1rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        border: 1px solid transparent;
      }

      .btn-cookie-accept {
        background: var(--primary);
        color: #ffffff;
      }

      .btn-cookie-refuse {
        background: #f1f5f9;
        color: var(--text-dark);
        border-color: var(--border);
      }
    </style>
  </head>
  <body>

    <header>
      <div class="header-content">
        <span class="logo-titre">{site.identite.nomCommercial}</span>
        <a href={`tel:${site.contact.telephoneLien}`} class="cta-phone-nav">
          📞 {site.contact.telephone}
        </a>
      </div>
    </header>

    <main>
      <section class="hero">
        <span class="badge">{site.identite.metier} à {site.contact.ville}</span>
        <h1>{site.identite.nomCommercial}</h1>
        <p class="tagline">{site.identite.tagline}</p>
        <a href={`tel:${site.contact.telephoneLien}`} class="btn-urgence">
          Appeler pour un dépannage ({site.contact.telephone})
        </a>
      </section>

      <section class="engagements">
        {site.engagements.map((item) => (
          <div class="engagement-item">✓ {item}</div>
        ))}
      </section>

      <section>
        <h2>Nos prestations et tarifs</h2>
        <div class="grid-services">
          {site.services.map((service) => (
            <article class="card-service">
              <div>
                <h3>{service.titre}</h3>
                <p>{service.description}</p>
              </div>
              <div class="tarif-service">{service.tarif}</div>
            </article>
          ))}
        </div>
      </section>

      <section class="zone-box">
        <strong>Zone d'intervention rapide :</strong>
        <p>Nous intervenons dans les localités suivantes : {site.contact.zoneIntervention}.</p>
      </section>

      <section>
        <h2>Questions fréquentes</h2>
        <div class="faq-list">
          {site.faq.map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.reponse}</p>
            </details>
          ))}
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-content">
        <div>
          <h4>{site.identite.nomCommercial}</h4>
          <p>{site.contact.adresse}<br />{site.contact.codePostal} {site.contact.ville}</p>
          <p>Tél : <a href={`tel:${site.contact.telephoneLien}`}>{site.contact.telephone}</a></p>
          <p>Email : <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
        </div>
        <div>
          <h4>Garanties professionnelles</h4>
          <p>Assurance décennale :<br />{site.identite.assuranceDecennale}</p>
          <p style="margin-top: 0.5rem;">Devis gratuit avant travaux.</p>
        </div>
        <div>
          <h4>Médiation de la consommation</h4>
          <p>{site.identite.mediateur}</p>
        </div>
      </div>

      <div class="mentions-legales">
        <p>
          <strong>Mentions légales & Confidentialité :</strong> {site.identite.raisonSociale} — SIRET : {site.identite.siret} — Hébergement : Cloudflare Pages (San Francisco, USA). Mesure d'audience soumise à consentement préalable via Google Analytics.
        </p>
        <button id="btn-reopen-cookies" class="btn-gestion-cookies" type="button">
          ⚙️ Gestion des préférences de cookies
        </button>
      </div>
    </footer>

    <!-- Bandeau Cookies RGPD -->
    <div id="cookie-banner" role="dialog" aria-modal="true" aria-labelledby="cookie-title">
      <div id="cookie-title" class="cookie-title">Mesure d'audience & vie privée</div>
      <p class="cookie-text">
        Ce site utilise des traceurs de mesure d'audience (Google Analytics 4) pour analyser son trafic et améliorer l'expérience utilisateur. Aucun traceur publicitaire n'est déposé sans votre consentement.
      </p>
      <div class="cookie-actions">
        <button id="cookie-refuse" class="btn-cookie btn-cookie-refuse" type="button">Refuser tout</button>
        <button id="cookie-accept" class="btn-cookie btn-cookie-accept" type="button">Accepter tout</button>
      </div>
    </div>

    <!-- Script de gestion du consentement et chargement conditionnel GA4 -->
    <script define:vars={{ gaId }}>
      const STORAGE_KEY = 'site_cookie_consent';
      const banner = document.getElementById('cookie-banner');
      const btnAccept = document.getElementById('cookie-accept');
      const btnRefuse = document.getElementById('cookie-refuse');
      const btnReopen = document.getElementById('btn-reopen-cookies');

      function loadGoogleAnalytics(id) {
        if (!id || id === 'G-XXXXXXXXXX') return;
        if (window.gaLoaded) return;
        window.gaLoaded = true;

        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${id}`;
        document.head.appendChild(script);

        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', id, { anonymize_ip: true });
      }

      function applyConsent(status) {
        localStorage.setItem(STORAGE_KEY, status);
        banner.classList.remove('visible');

        if (status === 'granted') {
          loadGoogleAnalytics(gaId);
        }
      }

      // Vérification du consentement au chargement
      const currentConsent = localStorage.getItem(STORAGE_KEY);
      if (currentConsent === 'granted') {
        loadGoogleAnalytics(gaId);
      } else if (!currentConsent) {
        banner.classList.add('visible');
      }

      // Écouteurs d'événements
      btnAccept.addEventListener('click', () => applyConsent('granted'));
      btnRefuse.addEventListener('click', () => applyConsent('denied'));
      btnReopen.addEventListener('click', () => {
        banner.classList.add('visible');
      });
    </script>

  </body>
</html>
